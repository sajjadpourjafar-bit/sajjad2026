{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sajjad2026",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9c0199bf-e463-492e-9ae2-e31c7f64099a","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8bd72ef16db04665a3f88dbfec368783" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
